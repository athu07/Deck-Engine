# Secrets — never commit these
.env
*.key

# Python virtual environments
venv/
.venv/
env/
.env/

# Python cruft
__pycache__/
*.pyc
.pytest_cache/

# Tooling artifacts
.playwright-mcp/

# Node.js dependencies
node_modules/

# Office temp / lock files
~$*

# Runtime-generated artifacts (regenerated by the app; not source).
# The directories are kept via a .gitkeep; their contents are ignored.
/output/*
!/output/.gitkeep
/meetings/*
!/meetings/.gitkeep
/staging/*
!/staging/.gitkeep
/learned_templates/*
!/learned_templates/.gitkeep
/build_context/*
!/build_context/.gitkeep
/client_logos/*
!/client_logos/.gitkeep
/static/renders/

# Logs & scratch dumps
err.log
_titles_dump.txt
_deck_cases.txt
